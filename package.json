{
  "name": "ninopulse-global-mobile",
  "private": true,
  "version": "5.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/noaa-service.test.js server/history-service.test.js server/api-utils.test.js server/country-api.test.js server/vercel-api.test.js server/live-country-service.test.js src/lib/experimentalModel.test.js src/lib/countryOutlook.test.js src/lib/runtime.test.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "android:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "android:run": "node ./node_modules/@capacitor/cli/bin/capacitor run android",
    "android:apk": "npm run android:config && npm run build && npm run android:sync && node scripts/android-build.js apk",
    "android:aab": "npm run android:config && npm run build && npm run android:sync && node scripts/android-build.js aab",
    "android:config": "node scripts/prepare-android-config.js",
    "android:prepare:windows": "scripts\\android-prepare.cmd"
  },
  "dependencies": {
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "7.4.4",
    "@capacitor/filesystem": "7.0.0",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "7.0.6",
    "@capacitor/share": "7.0.0",
    "@capacitor/splash-screen": "^7.0.5",
    "@tanstack/react-query": "^5.84.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.4",
    "@eslint/js": "^9.19.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "Mobile-first Android edition of NiñoPulse Global for Google Play internal and closed testing.",
  "engines": {
    "node": ">=20"
  }
}
